# Copy to secrets.env (development, in the project root) or to
# /etc/matrix/secrets.env (on the Pi; chmod 600). Never commit the real file.
#
# Create the token in Home Assistant:
#   your profile (bottom-left) > Security > Long-lived access tokens > Create token
# Use a dedicated account/token named "matrix-display"; the app only reads state.
MATRIX_HA_TOKEN=

# Optional: overrides [homeassistant].url from config.toml
# MATRIX_HA_URL=http://homeassistant:8123
